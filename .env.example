# Copie para .env.local e preencha. NUNCA commite valores reais.

# Supabase (somente servidor)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Auth por telefone
# PHONE_PEPPER: string aleatória longa (ex.: `openssl rand -base64 32`)
PHONE_PEPPER=
# Formato: perfil:hash,perfil:hash  (gere com `npm run phone:hash -- "+55..."`)
ALLOWED_PHONE_HASHES=
SESSION_SECRET=

# IA
GEMINI_API_KEY=
AI_DAILY_LIMIT=50

# Fallbacks de extração (opcionais)
APIFY_TOKEN=

# Keep-alive
CRON_SECRET=
