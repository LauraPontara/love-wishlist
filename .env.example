# Copie para .env.local e preencha. NUNCA commite valores reais.

# Supabase (somente servidor)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Auth por telefone
# PHONE_PEPPER: string aleatória longa (ex.: `openssl rand -base64 32`)
PHONE_PEPPER=
# Formato: perfil:hash,perfil:hash. Preencha com `npm run phone:hash` (pergunta perfil e telefone).
ALLOWED_PHONE_HASHES=
SESSION_SECRET=

# Web Push (gere com `npx web-push generate-vapid-keys`)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://seu-dominio.vercel.app

# Cron diário (keep-alive, lembretes, limpeza). A Vercel envia "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=
