# Copie para .env.local e preencha. NUNCA commite valores reais.

# Supabase (somente servidor)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Auth por telefone
# PHONE_PEPPER: string aleatória longa (ex.: `openssl rand -base64 32`)
PHONE_PEPPER=
# Formato: perfil:hash,perfil:hash  (gere com `npm run phone:hash -- "+55..."`)
ALLOWED_PHONE_HASHES=
SESSION_SECRET=

# Web Push (gere com `npx web-push generate-vapid-keys`)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:voce@exemplo.com

# Cron diário (keep-alive, lembretes, limpeza)
CRON_SECRET=
